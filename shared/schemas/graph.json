{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flare Hierarchical Data Schema",
  "description": "A recursive data schema for hierarchical visualizations (e.g., D3 circle packing, sunburst, or bubble tree).",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Label of the node."
    },
    "value": {
      "type": "number",
      "description": "Optional numeric value (used for sizing leaf nodes)."
    },
    "children": {
      "type": "array",
      "description": "Optional array of child nodes.",
      "items": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        }
      }
    }
  }
}